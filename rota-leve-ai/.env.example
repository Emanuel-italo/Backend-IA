# Copie para .env e preencha. NUNCA faça commit do .env (já está no .gitignore).
# No Render, estas variáveis ficam no render.yaml (valores públicos) e no painel Environment (segredos).

# Provedor da IA generativa: "groq" (padrão) ou "gemini".
LLM_PROVIDER=groq
# Chave do provedor (Groq: https://console.groq.com/keys). Vazio = modo template, sem IA generativa.
LLM_API_KEY=
# ID do modelo. Sem padrão de propósito: confira os IDs disponíveis para a sua chave em https://console.groq.com/docs/models
# (ou em GET https://api.groq.com/openai/v1/models). Vazio = modo template.
LLM_MODEL=
# Endpoint compatível com OpenAI. Padrão: Groq.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_S=10
LLM_MAX_RETRIES=1

# Chave que a API .NET/Java envia no header X-API-Key.
# Vazio = sem autenticação apenas localmente; com APP_ENV=production (Render) o /v1/routes/rank responde 503.
SERVICE_API_KEY=

RAG_TOP_K=2
RAG_MIN_SCORE=0.15
