# Copie para .env e preencha. NUNCA faça commit do .env (já está no .gitignore).

# Chave da Gemini API (https://aistudio.google.com/apikey). Vazio = modo template, sem IA generativa.
GEMINI_API_KEY=
# Modelo generativo. Confira o ID vigente em https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=gemini-3.6-flash
LLM_TIMEOUT_S=10
LLM_MAX_RETRIES=1

# Chave que a API .NET/Java envia no header X-API-Key. Vazio = sem autenticação (apenas desenvolvimento).
SERVICE_API_KEY=

RAG_TOP_K=2
RAG_MIN_SCORE=0.15
