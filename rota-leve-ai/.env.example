# Copie para .env e preencha. NUNCA faça commit do .env (já está no .gitignore).
# Na Vercel, cadastre estas mesmas variáveis em Settings > Environment Variables.

# Provedor da IA generativa: "grok" (padrão, xAI) ou "gemini".
LLM_PROVIDER=grok
# Chave do provedor (xAI: https://console.x.ai). Vazio = modo template, sem IA generativa.
LLM_API_KEY=
# ID do modelo. Sem padrão de propósito: confira os IDs disponíveis para a sua chave no console da xAI
# (ou em GET https://api.x.ai/v1/models). Vazio = modo template.
LLM_MODEL=
# Endpoint compatível com OpenAI. Padrão: xAI.
LLM_BASE_URL=https://api.x.ai/v1
LLM_TIMEOUT_S=10
LLM_MAX_RETRIES=1

# Chave que a API .NET/Java envia no header X-API-Key.
# Vazio = sem autenticação apenas localmente; na Vercel (production/preview) o /v1/routes/rank responde 503.
SERVICE_API_KEY=

RAG_TOP_K=2
RAG_MIN_SCORE=0.15
