# Copie para .env e preencha. NUNCA faça commit do .env (já está no .gitignore).
# No Render, estas variáveis ficam no painel Environment.

# Chave da Groq (https://console.groq.com/keys). Vazio = modo template, sem IA generativa.
LLM_API_KEY=
# ID do modelo (https://console.groq.com/docs/models), ex.: openai/gpt-oss-20b. Vazio = modo template.
LLM_MODEL=
LLM_TIMEOUT_S=10

# Chave que o backend e o servidor do front enviam no header X-API-Key. Vazio = sem autenticação (só local).
SERVICE_API_KEY=

RAG_TOP_K=2
RAG_MIN_SCORE=0.15
